+      policy: { quality, state: quality === 'KNOWN' ? any(['ACTIVE', 'ACTIVE', 'ACTIVE', 'PAUSED', 'STOPPED']) : null, last_reviewed_state: 'ACTIVE', reason: 'uji', review_at: null, review_due: false, recorded_at: '2026-09-20T00:00:00+00:00' } }
