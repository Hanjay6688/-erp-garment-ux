+// @vitest-environment node
+import { createHash } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { expect, test } from 'vitest'
+import { openRuntime, jsonArg } from './f04/runtime.mjs'
+import { DEFECTS as NETTING_DEFECTS } from './f04/netting-fixture.mjs'
+import { functionBlocks } from './f04/schedule-scenario-fixture.mjs'
+import { ACTOR, QUERY, ACCESS, STAGED_DEFECTS, installStagedControls, runJob, stagedInput } from './f04/staged-analysis-fixture.mjs'
+
+// P19 phase D PROTOTYPE: a staged run read BY TARGET RANGE. Over the staged
+// parity corpus, with tiny chunk bounds so page edges fall everywhere, the
+// header plus the pages reproduce the run's analysis and Original byte for
+// byte; the readers keep the segment reader's access-epoch and actor/run
+// binding. Kernel stand-ins only (schedule build, fabric, accessories); LOCAL.
+const SMALL = { targets_per_chunk: 7, pairs_per_chunk: 45, visits_per_allocation_step: 100000, allocation_targets_per_step: 4, targets_per_segment_unit: 10,
+  job_targets: 5000, job_pairs: 1000000, job_matching_products: 10000 }
+const bounds = (b: Record<string, number>) => `create or replace function cp7_analysis_stage.bounds()returns jsonb language sql immutable as $$select '${JSON.stringify(b)}'::jsonb$$;`
+const uuid = (n: number) => `03000000-0000-4000-8000-${n.toString(16).padStart(12, '0')}`
+type Row = Record<string, any>
+type Db = Awaited<ReturnType<typeof openRuntime>>
+const sha = (text: string) => createHash('sha256').update(Buffer.from(text, 'utf8')).digest('hex')
+
+// Independent of the page builder: reads the run's stored analysis (jsonb),
+// the Original as the segments hold it, and every page and header body.
+const VERIFY = `
+create function public.sp_verify(p_job uuid)returns jsonb language plpgsql as $s$
+declare j cp7_analysis_stage.jobs%rowtype;ps cp7_analysis_jobs.page_sets%rowtype;res jsonb;doc text;hdr jsonb;pj jsonb;k text;v jsonb;p record;
+ i integer:=0;expect integer:=1;pref bigint;n bigint;full_text text;paged_text text;without jsonb;rebuilt jsonb;running jsonb:='{}';bad text[]:='{}';
+ header_keys text[]:=array['contract_version','analysis_header','paged','targets_total','page_count','document_sha256','semantic_hash'];
+begin
+ select *into j from cp7_analysis_stage.jobs where id=p_job;
+ if j.state<>'DONE'then
+  return jsonb_build_object('state',j.state,'page_set',exists(select 1 from cp7_analysis_jobs.page_sets where run_id=j.run_id),
+   'pages',(select count(*)from cp7_analysis_jobs.pages where run_id=j.run_id));
+ end if;
+ select result into res from cp7_analysis_native.runs where id=j.run_id;
+ select string_agg(body,''order by idx)into doc from cp7_analysis_jobs.segments where run_id=j.run_id;
+ select *into ps from cp7_analysis_jobs.page_sets where run_id=j.run_id;
+ if ps.run_id is null then return jsonb_build_object('state',j.state,'page_set',false);end if;
+ hdr:=ps.header_body::jsonb;
+ if ps.header_body<>hdr::text then bad:=bad||'header_not_canonical'::text;end if;
+ if ps.header_sha256<>encode(sha256(convert_to(ps.header_body,'UTF8')),'hex')or ps.header_utf8_bytes<>octet_length(ps.header_body)then bad:=bad||'header_hash'::text;end if;
+ if hdr->>'contract_version'<>'cp7.native-analysis-header.v1'or hdr->'paged'<>ps.paged or (hdr->>'targets_total')::integer<>ps.targets_total
+  or (hdr->>'page_count')::integer<>ps.page_count or hdr->>'semantic_hash'<>res->>'semantic_hash'or ps.semantic_hash<>res->>'semantic_hash'
+  or hdr->>'document_sha256'<>encode(sha256(convert_to(doc,'UTF8')),'hex')or ps.document_sha256<>hdr->>'document_sha256'then bad:=bad||'header_binding'::text;end if;
+ -- Every page: canonical, hashed, bound, contiguous, counts and offsets.
+ for p in select *from cp7_analysis_jobs.pages x where x.run_id=j.run_id order by x.idx loop
+  pj:=p.body::jsonb;
+  if p.body<>pj::text then bad:=bad||('page_not_canonical:'||p.idx);end if;
+  if p.sha256<>encode(sha256(convert_to(p.body,'UTF8')),'hex')or p.utf8_bytes<>octet_length(p.body)then bad:=bad||('page_hash:'||p.idx);end if;
+  if pj->>'contract_version'<>'cp7.native-analysis-page.v1'or pj->>'run_id'<>j.run_id::text or pj->>'request_id'<>j.request_id::text
+   or (pj->>'index')::integer<>i or p.idx<>i or (pj->>'target_lo')::integer<>expect or p.target_lo<>expect or (pj->>'target_hi')::integer<>p.target_hi
+   or (pj->>'page_count')::integer<>ps.page_count or (pj->>'targets_total')::integer<>ps.targets_total or pj->>'document_sha256'<>ps.document_sha256
+   or pj->>'semantic_hash'<>ps.semantic_hash or pj->>'header_sha256'<>ps.header_sha256 or pj->'apply_enabled'<>'false'or pj->'production_go'<>'false'
+   or pj->'counts'<>p.counts or pj->'offsets'<>p.offsets or pj->'summary'<>p.summary
+   or (select array_agg(x order by x)from jsonb_object_keys(pj->'items')x)is distinct from(select array_agg(x order by x)from jsonb_object_keys(hdr->'paged')x)
+  then bad:=bad||('page_binding:'||p.idx);end if;
+  for k,v in select key,value from jsonb_each(hdr->'paged')loop
+   if (pj->'counts'->>k)::bigint<>jsonb_array_length(pj->'items'->k)or (pj->'offsets'->>k)::bigint<>coalesce((running->>k)::bigint,0)
+    or pj->'totals'->k<>v->'items'then bad:=bad||('page_counts:'||p.idx||':'||k);end if;
+   running:=running||jsonb_build_object(k,coalesce((running->>k)::bigint,0)+jsonb_array_length(pj->'items'->k));
+  end loop;
+  expect:=p.target_hi+1;i:=i+1;
+ end loop;
+ if i<>ps.page_count or expect<>ps.targets_total+1 then bad:=bad||'page_range'::text;end if;
+ -- Per paged array: the pages, in page order, are exactly the per-target
+ -- items of the analysis; the header holds exactly the other items.
+ without:=res;rebuilt:=hdr->'analysis_header';
+ for k,v in select key,value from jsonb_each(hdr->'paged')loop
+  pref:=(v->>'prefix')::bigint;n:=(v->>'items')::bigint;
+  if (running->>k)::bigint is distinct from n then bad:=bad||('items_total:'||k);end if;
+  select string_agg(x.e::text,', 'order by x.o)into full_text from jsonb_array_elements(res->k)with ordinality x(e,o)where x.o>pref and x.o<=pref+n;
+  select string_agg(y.e::text,', 'order by q.idx,y.o)into paged_text from cp7_analysis_jobs.pages q
+   cross join lateral jsonb_array_elements(q.body::jsonb->'items'->k)with ordinality y(e,o)where q.run_id=j.run_id;
+  if full_text is distinct from paged_text or jsonb_array_length(res->k)<>jsonb_array_length(hdr->'analysis_header'->k)+n then bad:=bad||('items:'||k);end if;
+  without:=jsonb_set(without,array[k],(select coalesce(jsonb_agg(x.e order by x.o),'[]'::jsonb)from jsonb_array_elements(res->k)with ordinality x(e,o)where x.o<=pref or x.o>pref+n));
+  rebuilt:=jsonb_set(rebuilt,array[k],(select coalesce(jsonb_agg(z.e order by z.g,z.o),'[]'::jsonb)from(
+   select 0 g,x.o,x.e from jsonb_array_elements(hdr->'analysis_header'->k)with ordinality x(e,o)where x.o<=pref
+   union all select 1+q.idx,y.o,y.e from cp7_analysis_jobs.pages q cross join lateral jsonb_array_elements(q.body::jsonb->'items'->k)with ordinality y(e,o)where q.run_id=j.run_id
+   union all select 1000000000,x.o,x.e from jsonb_array_elements(hdr->'analysis_header'->k)with ordinality x(e,o)where x.o>pref)z));
+ end loop;
+ if (hdr->'analysis_header')::text<>without::text then bad:=bad||'header_analysis'::text;end if;
+ if (hdr-header_keys)::text<>((select cp7_analysis_jobs.original(r)from cp7_analysis_native.runs r where r.id=j.run_id)-'contract_version'-'analysis')::text then bad:=bad||'header_original'::text;end if;
+ -- The whole Original rebuilt from header + pages = the segments, byte for byte,
+ -- and = the analysis text the semantic hash was computed over.
+ if rebuilt::text<>(select t.body from cp7_analysis_stage.texts t where t.job_id=j.id and t.kind='ANALYSIS')then bad:=bad||'rebuilt_analysis'::text;end if;
+ if ((hdr-header_keys)||jsonb_build_object('contract_version','cp7.native-analysis-run.v1','analysis',rebuilt))::text<>doc then bad:=bad||'rebuilt_document'::text;end if;
+ -- Whole-run totals from the server equal the analysis.
+ if ps.totals<>jsonb_build_object('targets',ps.targets_total,'items',(select coalesce(jsonb_object_agg(x.key,x.value->'items'),'{}'::jsonb)from jsonb_each(ps.paged)x),
+   'recommendations',(select jsonb_build_object('ACTIVE',count(*)filter(where r->>'production_state'='ACTIVE'),'PAUSED',count(*)filter(where r->>'production_state'='PAUSED'),
+     'STOPPED',count(*)filter(where r->>'production_state'='STOPPED'),'OTHER',count(*)filter(where r->>'production_state'is null or r->>'production_state'not in('ACTIVE','PAUSED','STOPPED')))
+     from jsonb_array_elements(res->'recommendations')r),
+   'policy_unreviewed',(select count(*)from jsonb_array_elements(res->'actions')x where x->>'primary_reason'='PRODUCTION_POLICY_UNREVIEWED'))
+  or ps.targets_total<>(select coalesce(sum(y.hi-y.lo+1),0)from cp7_analysis_stage.units y where y.job_id=j.id and y.kind='ANA_TARGETS')
+  then bad:=bad||'totals'::text;end if;
+ return jsonb_build_object('state',j.state,'page_set',true,'bad',to_jsonb(bad),'pages',ps.page_count,'targets',ps.targets_total,'paged',ps.paged,
+  'header_bytes',ps.header_utf8_bytes,'max_page_bytes',(select max(utf8_bytes)from cp7_analysis_jobs.pages where run_id=j.run_id),'document_bytes',octet_length(doc));
+end $s$;
+create function public.sp_case(c jsonb,p_request uuid,with_single boolean)returns jsonb language plpgsql as $s$
+declare job uuid;st jsonb;rid uuid;single jsonb;
+begin
+ job:=cp7_analysis_stage.create_job('${ACTOR}',p_request,'${JSON.stringify(QUERY)}'::jsonb,'${JSON.stringify(ACCESS)}'::jsonb,c);
+ loop st:=cp7_analysis_stage.step(job);exit when st->>'state'<>'RUNNING';end loop;
+ select run_id into rid from cp7_analysis_stage.jobs where id=job;
+ if with_single then single:=public.st_single(c,'${JSON.stringify(QUERY)}'::jsonb,rid,'${JSON.stringify(ACCESS)}'::jsonb);end if;
+ return public.sp_verify(job)||jsonb_build_object('failure',st->'failure','single',single->>'state',
+  'single_same',(select r.result::text from cp7_analysis_native.runs r where r.id=rid)=(single->'body')::text,
+  'stages',(select jsonb_agg(distinct kind)from cp7_analysis_stage.units where job_id=job and kind like 'PAGE%'));
+end $s$;`
+
+function corpus() {
+  const cases: { seed: number, defect: string | null, c: unknown }[] = []
+  const shapes = [{ targets: 40, positions: 16, roots: 14, models: 3, complete: true }, { targets: 30, positions: 24, roots: 9, models: 2, complete: false },
+    { targets: 9, positions: 3, roots: 4, models: 2, complete: true }]
+  // The f05-staged-analysis parity corpus (same seeds, shapes and defects).
+  for (let seed = 1; seed <= 3; seed++) for (const defect of [...NETTING_DEFECTS, ...STAGED_DEFECTS])
+    cases.push({ seed, defect, c: stagedInput(4000 + seed * 100 + cases.length, shapes[seed - 1], defect) })
+  for (let seed = 10; seed < 22; seed++) cases.push({ seed, defect: null, c: stagedInput(5000 + seed, shapes[seed % 3]) })
+  return cases
+}
+
+test('P19 staged pages: header + pages reproduce the analysis and the Original byte for byte; page edges everywhere', async () => {
+  const db = await openRuntime({ commandTimeoutMs: 600_000 })
+  try {
+    await installStagedControls(db, { bounds: SMALL })
+    await db.execute(VERIFY)
+    const cases = corpus()
+    const stats = { variants: [] as Row[], refusals: new Set<string>() }
+    // Pages of 7 targets with the single build compared (whole corpus), then
+    // pages of 1 and of 3 targets over two thirds of the corpus.
+    for (const [per, pick, single] of [[7, () => true, true], [1, (i: number) => i % 3 !== 0, false], [3, (i: number) => i % 3 !== 1, false]] as const) {
+      await db.execute(bounds({ ...SMALL, targets_per_chunk: per }))
+      const chosen = cases.filter((_, i) => pick(i))
+      const v = { per, cases: chosen.length, done: 0, failed: 0, pages: 0, multi_page: 0, zero_target: 0, page_edges: 0, single_same: 0, max_page_bytes: 0,
+        paged: {} as Record<string, number>, unpaged_material_null: 0 }
+      for (let i = 0; i < chosen.length; i += 10) {
+        const batch = chosen.slice(i, i + 10)
+        const rows = (await db.query(`select public.sp_case(x.value,('03000000-0000-4000-8${per}00-'||lpad(to_hex(${i}+x.ordinality::integer),12,'0'))::uuid,${single}) r
+          from jsonb_array_elements(${jsonArg(batch.map(k => k.c))}) with ordinality x order by x.ordinality`)).map((r: Row) => r.r)
+        rows.forEach((row: Row, k: number) => {
+          const id = [per, batch[k].seed, batch[k].defect]
+          if (row.state !== 'DONE') {
+            // A failed job exposes no page set and no page.
+            expect([...id, row.state, row.page_set, row.pages]).toEqual([...id, 'FAILED', false, 0])
+            v.failed++; stats.refusals.add(row.failure?.code); return
+          }
+          expect([...id, row.page_set, row.bad]).toEqual([...id, true, []])
+          expect([...id, row.stages]).toEqual([...id, ['PAGES', 'PAGE_HEADER', 'PAGE_INDEX'].filter(s => s !== 'PAGES' || row.pages > 0).sort()])
+          if (single) { if (row.single === 'DONE') { expect([...id, row.single_same]).toEqual([...id, true]); v.single_same++ } }
+          v.done++; v.pages += row.pages; if (row.pages > 1) v.multi_page++; if (row.targets === 0) v.zero_target++
+          v.page_edges += Math.max(0, row.pages - 1); v.max_page_bytes = Math.max(v.max_page_bytes, row.max_page_bytes ?? 0)
+          for (const key of Object.keys(row.paged)) v.paged[key] = (v.paged[key] ?? 0) + 1
+          if (!('material_needs' in row.paged) && row.targets > 0) v.unpaged_material_null++
+        })
+      }
+      stats.variants.push(v)
+    }
+    process.stdout.write(JSON.stringify({ variants: stats.variants, refusals: [...stats.refusals] }) + '\n')
+    const [seven, one, three] = stats.variants
+    expect(seven.done).toBeGreaterThanOrEqual(75); expect(seven.single_same).toBeGreaterThanOrEqual(70); expect(seven.multi_page).toBeGreaterThanOrEqual(40)
+    expect(one.page_edges).toBeGreaterThan(1000); expect(three.page_edges).toBeGreaterThan(300)
+    // Every paged array kind occurs, incl. the warnings of unreviewed policies,
+    // runs whose material needs are null (not paged) and runs without targets.
+    for (const v of stats.variants) {
+      for (const key of ['recommendations', 'actions', 'timeline', 'metrics', 'demand_models', 'material_needs', 'assumptions', 'generation_warnings'])
+        expect([v.per, key, (v.paged[key] ?? 0) > 0]).toEqual([v.per, key, true])
+      expect(v.zero_target).toBeGreaterThan(0)
+    }
+  } finally { await db.close() }
+}, 1_800_000)
+
+// Explicit stand-ins for the access reader and the source, as in
+// f05-analysis-jobs: the actor and its permissions come from settings.
+const ACCESS_STANDINS = `
+ create function cp7_schedule_native.access_now(writing boolean)returns jsonb language plpgsql stable set search_path='' as $$
+  begin
+   if coalesce(current_setting('test.actor',true),'')='' then raise exception using errcode='42501',message='CP7_ACCESS_DENIED';end if;
+   return jsonb_build_object('actor',current_setting('test.actor'),'permissions',coalesce(current_setting('test.perm',true),'view'));
+  end $$;
+ create function cp7_analysis_native.finance_mode(facts jsonb)returns text language sql immutable set search_path='' as $$
+  select case when facts->>'financial_capture'='DEFERRED'then 'DEFERRED'else 'INCLUDED'end$$;
+ -- The current source: the run's own facts (UNCHANGED), changed facts
+ -- (test.stale) or without the owner report (test.finance='hidden').
+ create function cp7_analysis_native.source_for(q jsonb,p_finance text)returns jsonb language sql stable set search_path='' as $$
+  select case when current_setting('test.finance',true)='hidden'then x.facts||'{"financial_source":null}'::jsonb else x.facts end
+   ||case when current_setting('test.stale',true)='1'then '{"analysis_engine_signature":"changed"}'::jsonb else '{}'::jsonb end
+  from cp7_analysis_native.runs x where x.id=current_setting('test.run')::uuid$$;`
+
+test('P19 page readers: segment-equal access epoch and actor/run binding, whole reads of a paged run refused, privileges, immutability', async () => {
+  const db = await openRuntime({ commandTimeoutMs: 600_000 })
+  try {
+    await installStagedControls(db, { bounds: SMALL })
+    const jobs = readFileSync('scripts/cp7-src/planning/analysis-jobs.sql', 'utf8'), blocks = functionBlocks(jobs)
+    // The product manifest/segment readers and their RPCs; the manifest gets
+    // the proposed guard (refuse_paged first, then the unchanged body).
+    await db.execute(`${ACCESS_STANDINS}
+     ${['cp7_analysis_jobs.manifest', 'cp7_analysis_jobs.segment', 'public.erp_cp7_read_analysis_manifest_v1', 'public.erp_cp7_read_analysis_segment_v1'].map(n => blocks.get(n)).join('\n')}
+     alter function cp7_analysis_jobs.manifest(uuid)rename to manifest_whole;
