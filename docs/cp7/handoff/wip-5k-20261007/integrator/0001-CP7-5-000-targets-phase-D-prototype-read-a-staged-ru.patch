+#!/usr/bin/env node
+// P19 phase D: where the bytes of an analysis Original are, per top-level
+// field, per analysis array and per per-target item; what a 5,000-target
+// staged run's pages and header weigh; and what one jsonb runs.result costs as
+// the Original grows. Three sources, labelled separately:
+//  - RETAINED_NATIVE_ORIGINALS: real Native Originals retained by the P19 load
+//    suite (docs/cp7/evidence/integration-8f/p19-native-load, source 8f326d87;
+//    0/1/4/12 factsets). Bytes only; no timing.
+//  - LOCAL_PG16_DEV assembly fixture (analysis-assembly-fixture.mjs) and staged
+//    fixture (staged-analysis-fixture.mjs + phase D page units). Stand-ins for
+//    the schedule build, fabric and accessories; never Native/Auth/HTTP evidence.
+//  - LOCAL_PG16_DEV storage costs of a jsonb runs.result at 1x / 2x / 3.2x /
+//    4.2x the staged 5,000-target analysis text (the larger ones SYNTHETIC: the
+//    run's own timeline items repeated).
+import { gunzipSync } from 'node:zlib'
+import { readFileSync, mkdirSync, writeFileSync } from 'node:fs'
+import { dirname } from 'node:path'
+import { openRuntime, jsonArg } from '../tests/cp7/families/f04/runtime.mjs'
+import { installAssemblyControls, assemblyInput, assemblyArgs } from '../tests/cp7/families/f04/analysis-assembly-fixture.mjs'
+import { installStagedControls, runJob, stagedInput } from '../tests/cp7/families/f04/staged-analysis-fixture.mjs'
+
+const out = process.argv[2] ?? 'test-results/cp7-shell-proof/P19_ORIGINAL_BYTES.json'
+const sizes = (process.env.CP7_P19_BYTES_SIZES || '100,300,1000').split(',').map(Number)
+const big = Number(process.env.CP7_P19_BYTES_BIG || 5000)
+const PAGED = ['recommendations', 'timeline', 'actions', 'demand_models', 'material_needs', 'metrics', 'assumptions', 'generation_warnings']
+const report = { contract: 'cp7.p19.original-bytes.v0', labels: { retained: 'RETAINED_NATIVE_ORIGINALS_8f326d87_BYTES_ONLY', local: 'LOCAL_PG16_DEV_KERNEL_STAND_INS_NOT_EVIDENCE' },
+  retained: [], assembly: [], staged: [], storage: [], status: 'INCOMPLETE', production_go: false }
+
+// PostgreSQL's jsonb text: ', ' and ': ' separators, keys in stored order.
+const pg = v => v === null || typeof v !== 'object' ? JSON.stringify(v) : Array.isArray(v) ? '[' + v.map(pg).join(', ') + ']'
+  : '{' + Object.entries(v).map(([k, x]) => JSON.stringify(k) + ': ' + pg(x)).join(', ') + '}'
+const bytes = v => Buffer.byteLength(pg(v), 'utf8')
+function breakdownJs(doc) {
+  const a = doc.analysis, targets = a.recommendations.length + a.generation_warnings.filter(w => String(w).startsWith('PRODUCTION_POLICY_UNREVIEWED:')).length
+  const refs = []; const walk = v => { if (Array.isArray(v)) v.forEach(walk); else if (v && typeof v === 'object') for (const [k, x] of Object.entries(v)) { if (k === 'refs' || k === 'event_refs' || k === 'source_links') refs.push(x); else walk(x) } }
+  walk(a)
+  return summarize({ utf8_bytes: bytes(doc), targets, top: Object.fromEntries(Object.entries(doc).map(([k, v]) => [k, bytes(v)])),
+    analysis: Object.fromEntries(Object.entries(a).map(([k, v]) => [k, { bytes: bytes(v), items: Array.isArray(v) ? v.length : null }])), refs_bytes: refs.reduce((n, r) => n + bytes(r), 0),
+    timeline_item_keys: a.timeline.length ? Object.fromEntries(Object.entries(a.timeline[0]).map(([k, v]) => [k, bytes(v)])) : null })
+}
+// Per-target share: the eight arrays a staged run pages, divided by targets.
+function summarize(b) {
+  const per = {}; let paged = 0
+  for (const [k, v] of Object.entries(b.analysis)) {
+    if (v.items !== null) Object.assign(v, { bytes_per_item: v.items ? Math.round((v.bytes - 2 - 2 * (v.items - 1)) / v.items) : null,
+      items_per_target: b.targets ? +(v.items / b.targets).toFixed(2) : null, bytes_per_target: b.targets ? Math.round(v.bytes / b.targets) : null })
+    if (PAGED.includes(k)) { paged += v.bytes; per[k] = v.bytes_per_target }
+  }
+  return { ...b, paged_arrays_bytes: paged, paged_bytes_per_target: b.targets ? Math.round(paged / b.targets) : null,
+    rest_bytes: b.utf8_bytes - paged, refs_share_of_analysis: +(b.refs_bytes / b.top.analysis).toFixed(3),
+    extrapolated_5000_bytes: b.targets ? Math.round(b.utf8_bytes - paged + (paged / b.targets) * 5000) : null }
+}
+const BREAKDOWN_SQL = `create function public.ob_breakdown(doc jsonb)returns jsonb language sql as $$
+ select jsonb_build_object('utf8_bytes',octet_length(doc::text),
+  'targets',jsonb_array_length(doc->'analysis'->'recommendations')+(select count(*)from jsonb_array_elements_text(doc->'analysis'->'generation_warnings')w where w like 'PRODUCTION_POLICY_UNREVIEWED:%'),
+  'top',(select jsonb_object_agg(key,octet_length(value::text))from jsonb_each(doc)),
+  'analysis',(select jsonb_object_agg(key,jsonb_build_object('bytes',octet_length(value::text),'items',case when jsonb_typeof(value)='array'then jsonb_array_length(value)end))
+    from jsonb_each(doc->'analysis')),
+  'refs_bytes',(select coalesce(sum(octet_length(v::text)),0)from jsonb_path_query(doc->'analysis','strict $.**.refs')v)
+   +(select coalesce(sum(octet_length(v::text)),0)from jsonb_path_query(doc->'analysis','strict $.**.event_refs')v)
+   +(select coalesce(sum(octet_length(v::text)),0)from jsonb_path_query(doc->'analysis','strict $.**.source_links')v),
+  'timeline_item_keys',(select jsonb_object_agg(key,octet_length(value::text))from jsonb_each(doc->'analysis'->'timeline'->0)))
+$$;`
+
+// ---------------------------------------------------------- retained real --
+const retained = JSON.parse(gunzipSync(readFileSync('docs/cp7/evidence/integration-8f/p19-native-load/ORIGINAL_REPORTS.json.gz')).toString('utf8'))
+for (const name of ['P19_LOAD_PROFILE_0.json', 'P19_LOAD_PROFILE_1.json', 'P19_LOAD_PROFILE_4.json', 'P19_LOAD_PROFILE_12.json']) {
+  const doc = { ...JSON.parse(retained.root_json_utf8[name]).observed.original }; delete doc.source_state
+  report.retained.push({ name, source_commit: retained.source_commit, ...breakdownJs(doc) })
+}
+console.log(JSON.stringify(report.retained.map(r => ({ name: r.name, targets: r.targets, utf8_bytes: r.utf8_bytes, paged_bytes_per_target: r.paged_bytes_per_target, extrapolated_5000_bytes: r.extrapolated_5000_bytes }))))
+
+const time = async (db, sql) => { const t0 = Date.now(); const r = await db.query(sql); return { ms: Date.now() - t0, rows: r } }
+try {
+  // --------------------------------------------------------------- assembly --
+  let db = await openRuntime({ commandTimeoutMs: 600_000 })
+  try {
+    report.runtime = db.flavor; report.version = db.version
+    await installAssemblyControls(db); await db.execute(BREAKDOWN_SQL)
+    for (const n of sizes) {
+      const c = assemblyInput(n, 2)
+      const [row] = (await db.query(`with a as materialized(select public.p19_assembly_1(${assemblyArgs(c)}) r)
+        select public.ob_breakdown(jsonb_build_object('contract_version','cp7.native-analysis-run.v1','run_id',r->'run_id','request_id','02000000-0000-4000-8000-000000000009',
+         'analysis',r,'product_labels',(select coalesce(jsonb_agg(jsonb_build_object('target_key',x->>'root_id'||':'||(x->>'size_id'),'sku',coalesce(x->'commercial'->0->>'sku',x->>'sku'),
+           'product_name',x->>'product_name')order by x->>'root_id'),'[]')from jsonb_array_elements(${jsonArg(c)}->'facts'->'products')x),
+         'query',${jsonArg({ from_date: '2026-10-01', through_date: '2026-10-06' })},'financial_source',null,'apply_enabled',false,'production_go',false)) b from a`))
+      report.assembly.push({ fixture: 'analysis-assembly-fixture assemblyInput(n,2)', requested_targets: n, ...summarize(row.b) })
+      console.log(JSON.stringify({ assembly: n, utf8_bytes: row.b.utf8_bytes, targets: row.b.targets, paged_bytes_per_target: report.assembly.at(-1).paged_bytes_per_target }))
+    }
+  } finally { await db.close() }
+
+  // ----------------------------------------------------------------- staged --
+  db = await openRuntime({ commandTimeoutMs: 600_000 })
+  try {
+    await installStagedControls(db); await db.execute(BREAKDOWN_SQL)
+    report.bounds = (await db.query('select cp7_analysis_stage.bounds() b, cp7_analysis_stage.page_bounds() p'))[0]
+    let k = 0
+    for (const n of [...sizes, big]) {
+      const roots = Math.ceil(n / 3.3), shape = { targets: n, positions: 100, roots, models: Math.max(3, Math.round(roots / 5)), complete: true }
+      const c = stagedInput(9000 + n, shape), units = []
+      const t0 = Date.now()
+      const job = await runJob(db, c, { request: `03000000-0000-4000-8000-${String(++k).padStart(12, '0')}`, oneCallPerUnit: n === big, timeout: '8s',
+        onStep: (s, ms) => units.push({ client_ms: ms, state: s.state }) })
+      const wall = Date.now() - t0
+      if (job.status.state !== 'DONE') throw new Error(`staged ${n}: ${JSON.stringify(job.status.failure)}`)
+      const [row] = await db.query(`select public.ob_breakdown(cp7_analysis_jobs.original(r)) b from cp7_analysis_native.runs r where r.id='${job.run_id}'`)
+      const [pages] = await db.query(`select s.targets_total,s.page_count,s.header_utf8_bytes,s.document_utf8_bytes,s.totals,
+        (select min(utf8_bytes) from cp7_analysis_jobs.pages p where p.run_id=s.run_id) min_page_bytes,(select max(utf8_bytes) from cp7_analysis_jobs.pages p where p.run_id=s.run_id) max_page_bytes,
+        (select sum(utf8_bytes) from cp7_analysis_jobs.pages p where p.run_id=s.run_id) sum_page_bytes
+        from cp7_analysis_jobs.page_sets s where s.run_id='${job.run_id}'`)
+      const server = await db.query(`select u.kind stage,count(*) n,max(o.server_ms) max_ms,sum(o.server_ms) sum_ms from cp7_analysis_stage.units u join cp7_analysis_stage.outputs o using(job_id,idx)
+        where u.job_id='${job.job}' group by u.kind order by min(u.idx)`)
+      report.staged.push({ fixture: 'staged-analysis-fixture stagedInput', targets: n, positions: 100, wall_ms: wall, one_call_per_unit: n === big, ...summarize(row.b),
+        pages, server_ms_by_stage: server })
+      console.log(JSON.stringify({ staged: n, utf8_bytes: row.b.utf8_bytes, paged_bytes_per_target: report.staged.at(-1).paged_bytes_per_target, pages,
+        page_units: server.filter(s => s.stage.startsWith('PAGE')) }))
+      if (n === big) {
+        // ------------------------------------------------- jsonb runs.result --
+        await db.execute(`create table public.ob_store(r jsonb);
+         create function public.ob_storage(p_job uuid,k numeric)returns jsonb language plpgsql as $s$
+         declare s text;tl text;t0 timestamptz;j jsonb;r jsonb:='{}';reps integer;
+         begin
+          select body into s from cp7_analysis_stage.texts where job_id=p_job and kind='ANALYSIS';
+          if k>1 then
+           select string_agg(body,', 'order by idx)into tl from cp7_analysis_stage.fragments where job_id=p_job and field='timeline'and items>0;
+           reps:=ceil((k-1)*octet_length(s)/octet_length(tl));
+           s:=replace(s,'"timeline": [','"timeline": ['||repeat(tl||', ',reps));
+          end if;
+          r:=jsonb_build_object('k',k,'synthetic',k>1,'text_utf8_bytes',octet_length(s));
+          t0:=clock_timestamp();perform encode(sha256(convert_to(s,'UTF8')),'hex');r:=r||jsonb_build_object('sha256_ms',round(extract(epoch from clock_timestamp()-t0)*1000));
+          begin
+           t0:=clock_timestamp();j:=s::jsonb;r:=r||jsonb_build_object('parse_ms',round(extract(epoch from clock_timestamp()-t0)*1000),'jsonb_datum_bytes',pg_column_size(j));
+           t0:=clock_timestamp();insert into public.ob_store values(j);r:=r||jsonb_build_object('insert_ms',round(extract(epoch from clock_timestamp()-t0)*1000),
+            'stored_bytes',(select pg_column_size(x.r)from public.ob_store x limit 1));
+           t0:=clock_timestamp();perform octet_length(j::text);r:=r||jsonb_build_object('render_text_ms',round(extract(epoch from clock_timestamp()-t0)*1000));
+          exception when others then r:=r||jsonb_build_object('refused',sqlstate||':'||sqlerrm);end;
+          truncate public.ob_store;
+          return r;
+         end $s$;`)
+        for (const f of [1, 2, 3.2, 4.2]) {
+          const [s] = await db.query(`select public.ob_storage('${job.job}',${f}) s`)
+          report.storage.push(s.s); console.log(JSON.stringify(s.s))
+        }
+      }
+    }
+  } finally { await db.close() }
+  report.status = 'COMPLETE'
+} catch (error) {
+  report.error = String(error?.stack ?? error); process.exitCode = 1
+} finally {
+  mkdirSync(dirname(out), { recursive: true }); writeFileSync(out, JSON.stringify(report, null, 1) + '\n')
+  console.log(JSON.stringify({ status: report.status, out, error: report.error }))
+}
