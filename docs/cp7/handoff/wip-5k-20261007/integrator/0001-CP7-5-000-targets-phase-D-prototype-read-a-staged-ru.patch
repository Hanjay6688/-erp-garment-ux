diff --git a/tests/cp7/families/f04/staged-pages.prototype.sql b/tests/cp7/families/f04/staged-pages.prototype.sql
new file mode 100644
index 00000000..81a98eab
--- /dev/null
+++ b/tests/cp7/families/f04/staged-pages.prototype.sql
@@ -0,0 +1,295 @@
+-- P19 phase D PROTOTYPE (test runtime only, not installed): reading a staged
+-- analysis run BY TARGET RANGE. Loaded after staged-analysis.prototype.sql.
+--
+-- A 5,000-target Original is about 210 MB in the real app (42 KB per target,
+-- 78 % of it the per-target timeline). The client refuses documents above
+-- 64 MB and must never show a part as the whole. A finished staged run is
+-- therefore also stored as
+--   * one HEADER: the Original without the per-target array items (contract
+--     cp7.native-analysis-header.v1), with, per paged analysis array, where
+--     the per-target items start (prefix) and how many there are (items);
+--   * PAGES, one per ANA_TARGETS chunk (target ordinals lo..hi in the job's
+--     loop order): the per-target items of that range for every paged array
+--     (contract cp7.native-analysis-page.v1), each a canonical jsonb text with
+--     its UTF8 size and sha256;
+--   * one PAGE SET row (written last, so a partly paged run is unreadable)
+--     listing whole-run totals, the header and every page hash, bound to the
+--     run's document (segments) sha256 and semantic hash.
+-- Pages are cut from the fragments the job already stored (no recompute):
+-- the per-target items of page k are exactly the text ANA_TEXT put in place of
+-- the sentinels, chunk k. The parity test (f05-staged-pages) proves, byte for
+-- byte, that header + pages reproduce the Original.
+--
+-- Changes to existing prototype objects: NONE of the existing unit bodies is
+-- changed. cp7_analysis_stage.run_unit is renamed run_unit_core and wrapped by
+-- a new run_unit that (a) after NET_PREP appends the page units to the fixed
+-- plan, (b) runs the three page unit kinds:
+--   ... DOC_SEGMENTS*k -> PAGE_HEADER -> PAGES*k -> PAGE_INDEX
+-- step() resolves run_unit by name, so it calls the wrapper unchanged.
+
+-- ------------------------------------------------------------------ tables --
+-- Immutable, deny-all, owned by cp7_capture like documents/segments.
+create table cp7_analysis_jobs.page_sets(run_id uuid primary key references cp7_analysis_jobs.documents(run_id),
+ contract_version text not null check(contract_version='cp7.native-analysis-pages.v1'),
+ targets_total integer not null check(targets_total>=0),page_count integer not null check(page_count>=0),
+ paged jsonb not null,totals jsonb not null,
+ header_body text not null,header_utf8_bytes integer not null check(header_utf8_bytes between 1 and 8000000),header_sha256 text not null,
+ document_sha256 text not null,document_utf8_bytes bigint not null,semantic_hash text not null,created_at timestamptz not null,
+ check((page_count=0)=(targets_total=0)));
+create table cp7_analysis_jobs.pages(run_id uuid not null references cp7_analysis_jobs.documents(run_id),idx integer not null check(idx>=0),
+ target_lo integer not null,target_hi integer not null,counts jsonb not null,offsets jsonb not null,summary jsonb not null,
+ body text not null,utf8_bytes integer not null check(utf8_bytes between 1 and 8000000),sha256 text not null,
+ primary key(run_id,idx),check(target_lo between 1 and target_hi));
+alter table cp7_analysis_jobs.page_sets owner to cp7_capture;
+alter table cp7_analysis_jobs.pages owner to cp7_capture;
+alter table cp7_analysis_jobs.page_sets enable row level security;
+alter table cp7_analysis_jobs.pages enable row level security;
+create policy cp7_analysis_page_sets_no_access on cp7_analysis_jobs.page_sets for all to public using(false)with check(false);
+create policy cp7_analysis_pages_no_access on cp7_analysis_jobs.pages for all to public using(false)with check(false);
+revoke all on cp7_analysis_jobs.page_sets,cp7_analysis_jobs.pages from public,anon,authenticated,service_role;
+create trigger immutable_analysis_page_set before update or delete on cp7_analysis_jobs.page_sets for each row execute function cp7_private.immutable_run();
+create trigger immutable_analysis_page before update or delete on cp7_analysis_jobs.pages for each row execute function cp7_private.immutable_run();
+
+-- ------------------------------------------------------------- page units --
+-- The existing per-unit body bound (8,000,000 UTF8 bytes) per page and for
+-- the header; above it the unit refuses loudly (no truncation).
+create function cp7_analysis_stage.page_bounds()returns jsonb
+language sql immutable security invoker set search_path=''as $$
+ select jsonb_build_object('page_utf8_bytes',8000000,'header_utf8_bytes',8000000)
+$$;
+-- Fragment field -> analysis array key.
+create function cp7_analysis_stage.page_field(f text)returns text
+language sql immutable security invoker set search_path=''as $$
+ select case f when 'warnings'then 'generation_warnings'when 'models'then 'demand_models'when 'materials'then 'material_needs'else f end
+$$;
+-- The paged arrays of a finished analysis: an array is paged iff its sentinel
+-- survived ANA_META (it has per-target items and, for material_needs, is not
+-- null); prefix = the sentinel's index (global items before the per-target
+-- items), items = the per-target item count over all chunks.
+create function cp7_analysis_stage.page_layout(p_job uuid)returns jsonb
+language plpgsql stable security invoker set search_path=''set TimeZone='UTC'as $$
+declare skel jsonb:=cp7_analysis_stage.output(p_job,'ANA_META')->'skeleton';tag text:=cp7_analysis_stage.tag(p_job);
+ f text;k text;pos bigint;hits bigint;n bigint;paged jsonb:='{}';
+begin
+ foreach f in array cp7_analysis_stage.fragment_fields()loop
+  k:=cp7_analysis_stage.page_field(f);
+  if jsonb_typeof(skel->k)='array'then
+   select min(x.o)-1,count(*)into pos,hits from jsonb_array_elements(skel->k)with ordinality x(v,o)where x.v=to_jsonb(tag||f);
+   if hits>1 then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+   if hits=1 then
+    select coalesce(sum(x.items),0)into n from cp7_analysis_stage.fragments x where x.job_id=p_job and x.field=f;
+    if n<1 then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+    paged:=paged||jsonb_build_object(k,jsonb_build_object('field',f,'prefix',pos,'items',n));
+   end if;
+  end if;
+ end loop;
+ return paged;
+end $$;
+-- Per page: recommendations by production state and targets whose production
+-- policy is unreviewed (their only item is the review-policy action).
+create function cp7_analysis_stage.page_summary(items jsonb)returns jsonb
+language sql immutable security invoker set search_path=''as $$
+ select jsonb_build_object('recommendations',jsonb_build_object(
+   'ACTIVE',count(*)filter(where r->>'production_state'='ACTIVE'),'PAUSED',count(*)filter(where r->>'production_state'='PAUSED'),
+   'STOPPED',count(*)filter(where r->>'production_state'='STOPPED'),
+   'OTHER',count(*)filter(where r->>'production_state'is null or r->>'production_state'not in('ACTIVE','PAUSED','STOPPED'))),
+  'policy_unreviewed',(select count(*)from jsonb_array_elements(coalesce(items->'actions','[]'))x where x->>'primary_reason'='PRODUCTION_POLICY_UNREVIEWED'))
+ from jsonb_array_elements(coalesce(items->'recommendations','[]'))r
+$$;
+create function cp7_analysis_stage.page_unit(j cp7_analysis_stage.jobs,u cp7_analysis_stage.units)returns jsonb
+language plpgsql volatile security invoker set search_path=''set TimeZone='UTC'as $$
+declare layout jsonb:=cp7_analysis_stage.page_layout(j.id);tag text:=cp7_analysis_stage.tag(j.id);b jsonb:=cp7_analysis_stage.page_bounds();
+ hash text:=cp7_analysis_stage.output(j.id,'ANA_TEXT')->>'semantic_hash';d cp7_analysis_jobs.documents%rowtype;
+ ntargets integer;npages integer;k text;v jsonb;body text;h cp7_analysis_stage.texts%rowtype;
+begin
+ select *into d from cp7_analysis_jobs.documents where run_id=j.run_id;
+ if d.run_id is null then raise exception 'CP7_ANALYSIS_PAGE_DOCUMENT_MISSING';end if;
+ select coalesce(sum(y.hi-y.lo+1),0),count(*)into ntargets,npages from cp7_analysis_stage.units y where y.job_id=j.id and y.kind='ANA_TARGETS';
+ if u.kind='PAGE_HEADER'then
+  -- The Original's non-analysis fields exactly as original() renders them,
+  -- and the analysis without the per-target items (each sentinel removed).
+  declare skel jsonb:=cp7_analysis_stage.output(j.id,'ANA_META')->'skeleton';c jsonb;header jsonb;
+  begin
+   for k,v in select key,value from jsonb_each(layout)loop
+    skel:=jsonb_set(skel,array[k],(select coalesce(jsonb_agg(x.e order by x.o),'[]'::jsonb)
+     from jsonb_array_elements(skel->k)with ordinality x(e,o)where x.e<>to_jsonb(tag||(v->>'field'))));
+   end loop;
+   select s.facts into c from cp7_analysis_stage.snapshots s where s.job_id=j.id;
+   header:=(cp7_analysis_jobs.original(row(j.run_id,j.actor,j.request_id,j.query,j.captured_at,j.access_at_capture,c,
+     to_jsonb(tag||'analysis'),j.source_hash)::cp7_analysis_native.runs)-'analysis'-'contract_version')
+    ||jsonb_build_object('contract_version','cp7.native-analysis-header.v1','analysis_header',skel||jsonb_build_object('semantic_hash',hash),
+     'paged',(select coalesce(jsonb_object_agg(x.key,x.value-'field'),'{}'::jsonb)from jsonb_each(layout)x),
+     'targets_total',ntargets,'page_count',npages,'document_sha256',d.sha256,'semantic_hash',hash);
+   body:=header::text;
+   if octet_length(body)>(b->>'header_utf8_bytes')::integer then raise exception 'CP7_ANALYSIS_PAGE_HEADER_LIMIT';end if;
+   insert into cp7_analysis_stage.texts values(j.id,'PAGE_HEADER',body,encode(pg_catalog.sha256(convert_to(body,'UTF8')),'hex'));
+   return jsonb_build_object('utf8_bytes',octet_length(body),'paged',layout);
+  end;
+ end if;
+ select *into h from cp7_analysis_stage.texts t where t.job_id=j.id and t.kind='PAGE_HEADER';
+ if h.job_id is null then raise exception 'CP7_ANALYSIS_PAGE_HEADER_MISSING';end if;
+ if u.kind='PAGES'then
+  -- Page u.chunk: the stored fragments of ANA_TARGETS chunk u.chunk.
+  declare a cp7_analysis_stage.units%rowtype;items jsonb:='{}';counts jsonb:='{}';offsets jsonb:='{}';totals jsonb:='{}';
+   frag cp7_analysis_stage.fragments%rowtype;off bigint;page jsonb;summary jsonb;
+  begin
+   select *into a from cp7_analysis_stage.units y where y.job_id=j.id and y.kind='ANA_TARGETS'and y.chunk=u.chunk;
+   if a.job_id is null or a.lo is distinct from u.lo or a.hi is distinct from u.hi then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+   for k,v in select key,value from jsonb_each(layout)loop
+    select *into frag from cp7_analysis_stage.fragments x where x.job_id=j.id and x.field=v->>'field'and x.idx=a.idx;
+    if frag.job_id is null then raise exception 'CP7_ANALYSIS_PAGE_FRAGMENT_MISSING';end if;
+    select coalesce(sum(x.items),0)into off from cp7_analysis_stage.fragments x join cp7_analysis_stage.units y on y.job_id=x.job_id and y.idx=x.idx
+     where x.job_id=j.id and x.field=v->>'field'and y.kind='ANA_TARGETS'and y.chunk<u.chunk;
+    items:=items||jsonb_build_object(k,('['||frag.body||']')::jsonb);
+    if jsonb_array_length(items->k)<>frag.items then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+    counts:=counts||jsonb_build_object(k,frag.items);offsets:=offsets||jsonb_build_object(k,off);totals:=totals||jsonb_build_object(k,v->'items');
+   end loop;
+   summary:=cp7_analysis_stage.page_summary(items);
+   page:=jsonb_build_object('contract_version','cp7.native-analysis-page.v1','run_id',j.run_id,'request_id',j.request_id,
+    'index',u.chunk,'page_count',npages,'target_lo',a.lo,'target_hi',a.hi,'targets_total',ntargets,
+    'document_sha256',d.sha256,'semantic_hash',hash,'header_sha256',h.sha256,
+    'counts',counts,'offsets',offsets,'totals',totals,'summary',summary,'items',items,'apply_enabled',false,'production_go',false);
+   body:=page::text;
+   if octet_length(body)>(b->>'page_utf8_bytes')::integer then raise exception 'CP7_ANALYSIS_PAGE_BODY_LIMIT';end if;
+   insert into cp7_analysis_jobs.pages(run_id,idx,target_lo,target_hi,counts,offsets,summary,body,utf8_bytes,sha256)
+   values(j.run_id,u.chunk,a.lo,a.hi,counts,offsets,summary,body,octet_length(body),encode(pg_catalog.sha256(convert_to(body,'UTF8')),'hex'));
+   return jsonb_build_object('index',u.chunk,'utf8_bytes',octet_length(body));
+  end;
+ end if;
+ if u.kind='PAGE_INDEX'then
+  -- Written last: every page present, contiguous over 1..total, counts
+  -- summing to the layout; then the run is readable by page.
+  declare p record;expect integer:=1;i integer:=0;sums jsonb:='{}';
+   rec jsonb:=jsonb_build_object('ACTIVE',0,'PAUSED',0,'STOPPED',0,'OTHER',0);unreviewed bigint:=0;
+  begin
+   for p in select *from cp7_analysis_jobs.pages x where x.run_id=j.run_id order by x.idx loop
+    if p.idx<>i or p.target_lo<>expect then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+    expect:=p.target_hi+1;i:=i+1;
+    for k in select key from jsonb_each(layout)loop
+     sums:=sums||jsonb_build_object(k,coalesce((sums->>k)::bigint,0)+(p.counts->>k)::bigint);
+    end loop;
+    for k in select key from jsonb_each(rec)loop
+     rec:=rec||jsonb_build_object(k,(rec->>k)::bigint+(p.summary->'recommendations'->>k)::bigint);
+    end loop;
+    unreviewed:=unreviewed+(p.summary->>'policy_unreviewed')::bigint;
+   end loop;
+   if i<>npages or expect<>ntargets+1 then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+   for k,v in select key,value from jsonb_each(layout)loop
+    if (sums->>k)::bigint is distinct from (v->>'items')::bigint then raise exception 'CP7_ANALYSIS_PAGE_LAYOUT';end if;
+   end loop;
+   insert into cp7_analysis_jobs.page_sets(run_id,contract_version,targets_total,page_count,paged,totals,header_body,header_utf8_bytes,header_sha256,
+    document_sha256,document_utf8_bytes,semantic_hash,created_at)
+   values(j.run_id,'cp7.native-analysis-pages.v1',ntargets,npages,(select coalesce(jsonb_object_agg(x.key,x.value-'field'),'{}'::jsonb)from jsonb_each(layout)x),
+    jsonb_build_object('targets',ntargets,'items',(select coalesce(jsonb_object_agg(x.key,x.value->'items'),'{}'::jsonb)from jsonb_each(layout)x),
+     'recommendations',rec,'policy_unreviewed',unreviewed),
+    h.body,octet_length(h.body),h.sha256,d.sha256,d.utf8_bytes,hash,clock_timestamp());
+   return jsonb_build_object('pages',npages,'targets',ntargets);
+  end;
+ end if;
+ raise exception 'CP7_ANALYSIS_STAGE_UNKNOWN_UNIT';
+end $$;
+
+alter function cp7_analysis_stage.run_unit(cp7_analysis_stage.jobs,cp7_analysis_stage.units)rename to run_unit_core;
+create function cp7_analysis_stage.run_unit(j cp7_analysis_stage.jobs,u cp7_analysis_stage.units)returns jsonb
+language plpgsql volatile security invoker set search_path=''set TimeZone='UTC'as $$
+declare out jsonb;n integer;k integer;
+begin
+ if u.kind in('PAGE_HEADER','PAGES','PAGE_INDEX')then return cp7_analysis_stage.page_unit(j,u);end if;
+ out:=cp7_analysis_stage.run_unit_core(j,u);
+ if u.kind='NET_PREP'then
+  -- The plan NET_PREP just fixed, plus the page units after DOC_SEGMENTS.
+  select x.unit_count into n from cp7_analysis_stage.jobs x where x.id=j.id;
+  if exists(select 1 from cp7_analysis_stage.units y where y.job_id=j.id and y.idx>=n)then raise exception 'CP7_ANALYSIS_STAGE_PLAN_MISMATCH';end if;
+  insert into cp7_analysis_stage.units values(j.id,n,'PAGE_HEADER',0,null,null);k:=n+1;
+  insert into cp7_analysis_stage.units select j.id,k+(row_number()over(order by y.chunk))::integer-1,'PAGES',y.chunk,y.lo,y.hi
+   from cp7_analysis_stage.units y where y.job_id=j.id and y.kind='ANA_TARGETS';
+  select count(*)+k into k from cp7_analysis_stage.units y where y.job_id=j.id and y.kind='ANA_TARGETS';
+  insert into cp7_analysis_stage.units values(j.id,k,'PAGE_INDEX',0,null,null);
+  update cp7_analysis_stage.jobs set unit_count=k+1 where id=j.id;
+ end if;
+ return out;
+end $$;
+
+-- ---------------------------------------------------------------- readers --
+-- Same refusals as manifest(): fresh access, actor-bound run, protected
+-- finance still visible; the full check runs once and returns the access
+-- epoch every page read must present. Returns the page index, the whole-run
+-- totals and the header body (<= 8,000,000 bytes) in one response.
+create function cp7_analysis_jobs.pages_manifest(p_run uuid)returns jsonb
+language plpgsql volatile security invoker set search_path=''set TimeZone='UTC'as $$
+declare a jsonb;r cp7_analysis_native.runs%rowtype;c jsonb;d cp7_analysis_jobs.documents%rowtype;s cp7_analysis_jobs.page_sets%rowtype;pages jsonb;
+begin
+ if current_setting('transaction_isolation')<>'read committed'then raise exception 'CP7_FRESH_ACCESS_REQUIRED';end if;
+ a:=cp7_schedule_native.access_now(false);select *into r from cp7_analysis_native.runs where id=p_run and actor=(a->>'actor')::uuid;
+ if r.id is null then raise exception using errcode='42501',message='CP7_ANALYSIS_RUN_UNAVAILABLE';end if;
+ c:=cp7_analysis_native.source_for(r.query,cp7_analysis_native.finance_mode(r.facts));
+ if r.facts->'financial_source' is not null and r.facts->'financial_source'<>'null'::jsonb and coalesce(c->'financial_source','null')='null'::jsonb then
+  raise exception using errcode='42501',message='CP7_ANALYSIS_FINANCE_ACCESS_DENIED';
+ end if;
+ if coalesce(r.facts->'financial_source'->'report'->'close_preflight','null')<>'null'::jsonb
+  and coalesce(c->'financial_source'->'report'->'close_preflight','null')='null'::jsonb then
+  raise exception using errcode='42501',message='CP7_ANALYSIS_FINANCE_ACCESS_DENIED';
+ end if;
+ select *into s from cp7_analysis_jobs.page_sets where run_id=r.id;
+ if s.run_id is null then raise exception 'CP7_ANALYSIS_PAGES_UNAVAILABLE';end if;
+ select *into d from cp7_analysis_jobs.documents where run_id=r.id;
+ select coalesce(jsonb_agg(jsonb_build_object('index',x.idx,'target_lo',x.target_lo,'target_hi',x.target_hi,'utf8_bytes',x.utf8_bytes,
+   'sha256',x.sha256,'counts',x.counts)order by x.idx),'[]'::jsonb)into pages from cp7_analysis_jobs.pages x where x.run_id=r.id;
+ if cp7_schedule_native.access_now(false)is distinct from a then raise exception using errcode='42501',message='CP7_ANALYSIS_ACCESS_CHANGED';end if;
+ return jsonb_build_object('contract_version','cp7.native-analysis-pages.v1','run_id',r.id,'request_id',r.request_id,
+  'source_state',case when cp7_analysis_native.fingerprint(c)=r.dependency_hash then 'UNCHANGED'else 'ARCHIVED_STALE'end,
+  'access_epoch',encode(pg_catalog.sha256(convert_to(a::text,'UTF8')),'hex'),
+  'document',jsonb_build_object('utf8_bytes',d.utf8_bytes,'characters',d.characters,'sha256',d.sha256,
+   'segment_count',d.segment_count,'segment_characters',d.segment_characters),
+  'semantic_hash',s.semantic_hash,'targets_total',s.targets_total,'page_count',s.page_count,'paged',s.paged,'totals',s.totals,
+  'header',jsonb_build_object('utf8_bytes',s.header_utf8_bytes,'sha256',s.header_sha256,'body',s.header_body),
+  'pages',pages,'apply_enabled',false,'production_go',false);
+end $$;
+-- Same checks as segment(): the unchanged access epoch, the actor's own run.
+create function cp7_analysis_jobs.page(p_run uuid,p_index integer,p_access text)returns jsonb
+language plpgsql stable security invoker set search_path=''set TimeZone='UTC'as $$
+declare a jsonb;s cp7_analysis_jobs.page_sets%rowtype;p cp7_analysis_jobs.pages%rowtype;
+begin
+ if current_setting('transaction_isolation')<>'read committed'then raise exception 'CP7_FRESH_ACCESS_REQUIRED';end if;
+ a:=cp7_schedule_native.access_now(false);
+ if p_access is distinct from encode(pg_catalog.sha256(convert_to(a::text,'UTF8')),'hex')then
+  raise exception using errcode='42501',message='CP7_ANALYSIS_ACCESS_CHANGED';
+ end if;
+ if not exists(select 1 from cp7_analysis_native.runs where id=p_run and actor=(a->>'actor')::uuid)then
+  raise exception using errcode='42501',message='CP7_ANALYSIS_RUN_UNAVAILABLE';
+ end if;
+ select *into s from cp7_analysis_jobs.page_sets where run_id=p_run;
+ if s.run_id is null then raise exception 'CP7_ANALYSIS_PAGES_UNAVAILABLE';end if;
+ select *into p from cp7_analysis_jobs.pages where run_id=p_run and idx=p_index;
+ if p.run_id is null then raise exception 'CP7_ANALYSIS_PAGE_UNAVAILABLE';end if;
+ return jsonb_build_object('contract_version','cp7.native-analysis-page-read.v1','run_id',p_run,'index',p.idx,'page_count',s.page_count,
+  'target_lo',p.target_lo,'target_hi',p.target_hi,'header_sha256',s.header_sha256,'document_sha256',s.document_sha256,
+  'utf8_bytes',p.utf8_bytes,'sha256',p.sha256,'body',p.body);
+end $$;
+-- Proposal for serve() and manifest(): a paged run is never read whole. The
+-- refusal comes after the actor check (a foreign run stays UNAVAILABLE) and
+-- tells the client to read by page; an old client gets a refusal, not a part.
+create function cp7_analysis_jobs.refuse_paged(p_run uuid)returns void
+language plpgsql stable security invoker set search_path=''set TimeZone='UTC'as $$
+declare a jsonb:=cp7_schedule_native.access_now(false);
+begin
+ if exists(select 1 from cp7_analysis_native.runs r join cp7_analysis_jobs.page_sets s on s.run_id=r.id where r.id=p_run and r.actor=(a->>'actor')::uuid)then
+  raise exception 'CP7_ANALYSIS_RUN_PAGED';
+ end if;
+end $$;
+alter function cp7_analysis_jobs.pages_manifest(uuid)owner to cp7_capture;
+alter function cp7_analysis_jobs.page(uuid,integer,text)owner to cp7_capture;
+alter function cp7_analysis_jobs.refuse_paged(uuid)owner to cp7_capture;
+revoke all on function cp7_analysis_jobs.pages_manifest(uuid),cp7_analysis_jobs.page(uuid,integer,text),cp7_analysis_jobs.refuse_paged(uuid)
+ from public,anon,authenticated,service_role;
+grant create on schema public to cp7_capture;
+create function public.erp_cp7_read_analysis_pages_v1(p_run uuid)returns jsonb
+language sql volatile security definer set search_path=''as $$select cp7_analysis_jobs.pages_manifest(p_run)$$;
+create function public.erp_cp7_read_analysis_page_v1(p_run uuid,p_index integer,p_access text)returns jsonb
+language sql volatile security definer set search_path=''as $$select cp7_analysis_jobs.page(p_run,p_index,p_access)$$;
+alter function public.erp_cp7_read_analysis_pages_v1(uuid)owner to cp7_capture;
+alter function public.erp_cp7_read_analysis_page_v1(uuid,integer,text)owner to cp7_capture;
+revoke create on schema public from cp7_capture;
+revoke all on function public.erp_cp7_read_analysis_pages_v1(uuid),public.erp_cp7_read_analysis_page_v1(uuid,integer,text)
+ from public,anon,authenticated,service_role;
+grant execute on function public.erp_cp7_read_analysis_pages_v1(uuid),public.erp_cp7_read_analysis_page_v1(uuid,integer,text)to authenticated;
