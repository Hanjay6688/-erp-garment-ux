+    def refusal_equals_single():
+        # The single path's grid refusal (targets x history days above 100,000)
+        # is the same refusal on the staged path: the job fails at its unit
+        # with the same code and SQLSTATE, and nothing is paged. Seeded with
+        # the scale ladder's own writer seeding inside this rolled-back case.
+        import cp7_p19_scale_cases as scale
+        size, days = scale.NATIVE_CASE['size'], scale.NATIVE_CASE['grid_cap_days']
+        seed = scale.ensure(cur, today, size, False)
