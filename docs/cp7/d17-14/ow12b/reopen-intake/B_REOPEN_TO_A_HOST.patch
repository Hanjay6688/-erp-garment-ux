+ expect(continuation().disabled).toBe(false)
+ await advance(2000)
+ expect(container.textContent).toContain('Persiapan selesai. Pilihan belum disimpan.')
+ expect(container.querySelector('[data-ready]')?.getAttribute('data-ready')).toBe('true')
