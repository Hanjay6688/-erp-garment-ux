  "definitions": {
    "ordinal": "immutable causal Native-post registration, corrections preserve root ordinal",
    "target": "T_i=F(base+families1..i)-F(base+families1..i-1)",
    "base_condition": "F(noReturns)=0 at every joint prefix",
    "family_condition": "every family cumulative NET <=0 at every joint prefix",
    "adjustment": "target exact-pair components minus all retained signed cohort components",
    "consumption": "positive consumes, negative real inverse restores; every cohort must remain nonnegative at every affected joint prefix"
  },
