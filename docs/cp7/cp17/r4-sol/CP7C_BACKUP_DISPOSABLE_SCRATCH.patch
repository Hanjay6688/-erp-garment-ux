@@ -246,6 +256,33 @@ def is_local(url):
     return (u.hostname or '') in LOCAL_HOSTS
 
 
+SYSTEM_DATABASES = ('template0', 'template1')
+
+
+def scratch_server(admin_url):
+    """Every database of the scratch server as (oid, name), and the number of other client sessions on it."""
+    with psycopg.connect(admin_url) as conn, conn.cursor() as cur:
+        dbs = [tuple(r) for r in cur.execute('select oid,datname from pg_database order by oid').fetchall()]
+        others = cur.execute("select count(*) from pg_stat_activity where backend_type='client backend' and pid<>pg_backend_pid()").fetchone()[0]
+    return dbs, others
+
+
+def assert_server_only(admin_url, allowed_oids, code):
+    """The scratch server holds only its system databases and `allowed_oids`, and nobody else is connected."""
+    maintenance = urlparse(admin_url).path.lstrip('/') or 'postgres'
+    dbs, others = scratch_server(admin_url)
+    # A session this tool (or pg_restore) has just closed can still be listed for a moment while its backend exits.
+    for _ in range(50):
+        if not others:
+            break
+        time.sleep(0.1)
+        dbs, others = scratch_server(admin_url)
+    unrelated = sorted(n for o, n in dbs if n not in SYSTEM_DATABASES + (maintenance,) and o not in allowed_oids)
+    assert not unrelated, (code, unrelated)
+    assert others == 0, ('BACKUP_SCRATCH_SERVER_IN_USE', others)
+    return len(dbs)
+
+
