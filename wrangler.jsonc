{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erp-garment-ux",
  "compatibility_date": "2026-08-27",
  "env": {
    "uat-auth": {
      "name": "erp-garment-ux-uat-auth",
      "workers_dev": true,
      "preview_urls": true
    }
  },
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  }
}
