# TEMPLATE ONLY. Reviewed installation in a PRIVATE operations repository is required.
# Copy this file to .github/workflows/erp-healthcheck.yml and healthcheck.py to scripts/.
# This proposal neither enables a schedule nor connects to hosted Supabase.
name: ERP database health check
'on':
  workflow_dispatch: {}
  schedule:
    - cron: '17 1,7,13,19 * * *'  # 08:17, 14:17, 20:17, 02:17 WIB (UTC+7).
permissions:
  contents: read
concurrency:
  group: erp-database-healthcheck
  cancel-in-progress: false
jobs:
  check:
    if: ${{ vars.ERP_HEALTHCHECK_ENABLED == 'true' && github.event.repository.private == true }}
    runs-on: ubuntu-24.04
    timeout-minutes: 3
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
      - name: Install pinned database client
        run: python -m pip install --disable-pip-version-check 'psycopg[binary]==3.2.10'
      - name: One read-only database check
        env:
          ERP_HEALTHCHECK_ENABLED: ${{ vars.ERP_HEALTHCHECK_ENABLED }}
          ERP_HEALTHCHECK_PROJECT_REF: ${{ vars.ERP_HEALTHCHECK_PROJECT_REF }}
          ERP_HEALTHCHECK_DATABASE_URL: ${{ secrets.ERP_HEALTHCHECK_DATABASE_URL }}
        run: timeout --signal=TERM --kill-after=5s 30s python scripts/healthcheck.py
