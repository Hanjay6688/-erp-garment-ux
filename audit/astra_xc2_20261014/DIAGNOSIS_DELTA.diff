+# Diagnosis only (Fable retest of 7a0b4a90, owner 13 Oct 2026): when a boundary or public-schema comparison fails, the
+# report and the job log name what differed. Nothing here decides a result; the comparisons themselves are unchanged.
+CATALOG_OBSERVATION="""select jsonb_build_object('relname',relname,'n_live_tup',n_live_tup,'n_mod_since_analyze',n_mod_since_analyze,
+  'last_autoanalyze',last_autoanalyze,'last_analyze',last_analyze,'last_autovacuum',last_autovacuum,
+  'autoanalyze_count',autoanalyze_count,'autovacuum_count',autovacuum_count)
+  from pg_stat_sys_tables where schemaname='pg_catalog' and relname in('pg_proc','pg_namespace') order by relname"""
+
+
+def catalog_observation(cur):
+    """pg_proc/pg_namespace statistics and the plan of the public function listing (what can reorder that listing).
+    Inside its own savepoint: an observation that cannot be read is recorded as an error and changes nothing else."""
+    def nodes(n):
+        return [n.get('Node Type')+(':'+n['Relation Name'] if n.get('Relation Name') else '')]+[x for c in n.get('Plans',[]) for x in nodes(c)]
+    try:
+        cur.execute('savepoint auditor_observe')
+        plan=cur.execute('explain (format json,costs false) '+PUBLIC_STATE).fetchone()[0]
+        out=dict(stats=[r[0] for r in cur.execute(CATALOG_OBSERVATION).fetchall()],public_state_plan=nodes(plan[0]['Plan']))
+        cur.execute('release savepoint auditor_observe')
+        return out
+    except Exception as exc:
+        try:cur.execute('rollback to savepoint auditor_observe')
+        except Exception:pass
+        return dict(error=str(exc)[:300])
+
+
