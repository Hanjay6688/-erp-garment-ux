"  const browser=await chromium.launch({executablePath:process.env.CHROME_BIN})\n  const ctxA=await browser.newContext({timezoneId:'America/Los_Angeles'})\n  const ctxB=await browser.newContext({timezoneId:'Asia/Jakarta'})\n  const a=await ctxA.newPage(), b=await ctxB.newPage()\n  for(const p of [a,b]) p.setDefaultTimeout(9000)\n  const button=(p,name)=>p.getByRole('button',{name,exact:true})\n  const region=p=>p.getByRole('region',{name:'Daftar pengingat'})\n  const list=p=>region(p).locator('article')\n  const titles=p=>list(p).evaluateAll(nodes=>nodes.map(n=>n.getAttribute('aria-label').slice('Pengingat '.length)))\n  const freshFacts=()=>ctl('/facts')\n  const expectedTitles=rows=>rows.map(row=>row.title)\n  const notice='Urutan pengingat berubah. Daftar terbaru ditampilkan dari awal.'\n  async function ready(p) {\n    await expect(region(p)).toBeVisible()\n    await expect(p.getByText('Memuat pengingat\u2026',{exact:true})).toHaveCount(0)\n  }\n  async function open(p) {\n    await p.goto(origin)\n    await button(p,'Belum selesai').click()\n    await ready(p)\n  }\n  async function seed(n) {await ctl('/seed',{n});await open(a)}\n  async function next(p) {await button(p,'Pengingat berikutnya').click();await ready(p)}\n  async function refresh(p) {await button(p,'Muat ulang pengingat').click();await ready(p)}\n  async function edit(p,title,label,value) {\n    await button(p,'Ubah '+title).click()\n    await p.getByLabel(label,{exact:true}).fill(value)\n    await button(p,'Simpan perubahan').click()\n    await expect(p.getByText(/Perubahan pengingat .* disimpan\\./)).toBeVisible()\n    await ready(p)\n  }\n  const queries=[]\n  a.on('request',r=>{\n    if(r.url()===origin+'/rpc' && r.postDataJSON()?.name==='erp_cp7_get_reminders_v1')\n      queries.push(r.postDataJSON().args.p_query)\n  })\n  async function test(id,body) {\n    let result={}\n    try {await body(result);record({id,outcome:'PASS',...result})}\n    catch(e){record({id,outcome:'FAIL',...result,error:String(e.message||e).slice(0,1100)})}\n  }\n  try {\n    for(const n of [26,51,1]) await test('last-open-'+n,async proof=>{\n      await seed(n)\n      for(let offset=25;offset<n;offset+=25) await next(a)\n      await button(a,'Tandai selesai R'+(n-1)).click()\n      const offset=Math.max(0,(Math.ceil((n-1)/25)-1)*25)\n      const label=n===1?'Tidak ada pengingat':(offset+1)+'\u2013'+(n-1)+' dari '+(n-1)\n      await expect(a.getByText(label,{exact:true})).toBeVisible()\n      const firstDisplay=await titles(a)\n      await refresh(a)\n      const facts=await freshFacts(), displayed=await titles(a)\n      Object.assign(proof,{heading:label,offset,sqlOpen:facts.length,displayed,refresh:queries.at(-1)})\n      assert.equal(facts.length,n-1)\n      assert.deepEqual(displayed,expectedTitles(facts.slice(offset,offset+25)))\n      assert.deepEqual(firstDisplay,displayed)\n      assert.deepEqual(queries.at(-1),{filter:'OPEN',offset,limit:25})\n    })\n    for(const mode of ['remove','insert','reorder']) await test('adjacent-'+mode,async proof=>{\n      await seed(28)\n      await ctl('/change',{mode})\n      await next(a)\n      await expect(a.getByText(notice,{exact:true})).toBeVisible()\n      const first=await titles(a)\n      await next(a)\n      const all=[...first,...await titles(a)], facts=await freshFacts()\n      Object.assign(proof,{notice,sqlOpen:facts.length,seen:all,unique:new Set(all).size})\n      assert.deepEqual(all,expectedTitles(facts))\n      assert.equal(new Set(all).size,facts.length)\n    })\n    await test('second-session-shrink-on-refresh',async proof=>{\n      await seed(51);await next(a);await next(a)\n      await ctl('/change',{mode:'remove'});await refresh(a)\n      await expect(a.getByText('26\u201350 dari 50',{exact:true})).toBeVisible()\n      const facts=await freshFacts()\n      Object.assign(proof,{visible:await titles(a),dbRange:expectedTitles(facts.slice(25,50)),request:queries.at(-1)})\n      assert.deepEqual(proof.visible,proof.dbRange)\n      assert.deepEqual(proof.request,{filter:'OPEN',limit:25,offset:25})\n    })\n    for(const [mode,label,value] of [\n      ['title','Judul pengingat','Astra follow-up'],['note','Catatan pengingat','Astra catatan saja'],\n      ['midnight','Jatuh tempo pengingat (WIB)','2026-11-21T00:00']\n    ]) await test('committed-'+mode,async proof=>{\n      await seed(1)\n      const [before]=await freshFacts()\n      await edit(a,'R0',label,value)\n      const [after]=await freshFacts()\n      Object.assign(proof,{before,after,browserZone:await a.evaluate(()=>Intl.DateTimeFormat().resolvedOptions().timeZone)})\n      assert.equal(before.due,'2026-11-20T07:00:32.942069+00:00')\n      assert.equal(after.due,mode==='midnight'?'2026-11-20T17:00:00+00:00':before.due)\n      assert.equal(after.id,before.id)\n      assert.equal(after.version,before.version+1)\n      assert.equal(after.title,mode==='title'?value:before.title)\n      assert.equal(after.note,mode==='note'?value:before.note)\n    })\n    await test('normal-source',async proof=>{\n      await seed(1)\n      await edit(a,'R0','Jatuh tempo pengingat (WIB)','2020-02-29T23:59')\n      await expect(a.getByText('Lewat jatuh tempo',{exact:true})).toBeVisible()\n      const [row]=await freshFacts()\n      assert.equal(row.due,'2020-02-29T16:59:00+00:00')\n      proof.normalSidebar=await a.getByRole('region',{name:'Ringkasan pengingat'}).innerText()\n      proof.stored=row\n    })\n    for(const variation of ['summary','row-state','day','zone']) await test('reject-and-recover-'+variation,async proof=>{\n      await a.route('**/rpc',async route=>{\n        const response=await route.fetch(), reply=await response.json(), w=reply.data\n        assert.equal(w.items.length,1);assert.equal(w.due.overdue,1)\n        if(variation==='summary')w.due.overdue=0\n        if(variation==='row-state')w.items[0].due_state='TOMORROW'\n        if(variation==='day')w.today='2026-04-31'\n        if(variation==='zone')w.read_at=w.read_at.replace(/(?:Z|[+-]\\d\\d:\\d\\d)$/,'')\n        await route.fulfill({response,json:reply})\n      },{times:1})\n      await button(a,'Muat ulang pengingat').click()\n      await expect(a.getByRole('alert')).toBeVisible()\n      await expect(a.getByRole('region',{name:'Ringkasan pengingat'})).toHaveCount(0)\n      await expect(list(a)).toHaveCount(0)\n      proof.message=await a.getByRole('alert').innerText()\n      await refresh(a)\n      assert.deepEqual(await titles(a),['R0'])\n      await expect(a.getByText('Lewat jatuh tempo',{exact:true})).toBeVisible()\n      assert.equal((await freshFacts())[0].due,'2020-02-29T16:59:00+00:00')\n      proof.realResponseRecovered=true\n    })\n    await test('two-tabs-three-pages-same-count',async proof=>{\n      await seed(51)\n      const before=await freshFacts()\n      const first=await titles(a)\n      await next(a)\n      const middle=await titles(a)\n      await open(b)\n      await edit(b,'R0','Jatuh tempo pengingat (WIB)','2041-01-01T12:05')\n      await next(b)\n      await edit(b,'R50','Jatuh tempo pengingat (WIB)','2020-01-01T09:00')\n      const after=await freshFacts(), sql=expectedTitles(after)\n      assert.equal(sql.length,51);assert.equal(sql[0],'R50');assert.equal(sql.at(-1),'R0')\n      assert.deepEqual(sql.slice(25,50),middle)\n      await next(a)\n      const informed=await a.getByText(notice,{exact:true}).isVisible()\n      const tail=await titles(a), seen=[...first,...middle,...tail]\n      const missed=sql.filter(title=>!seen.includes(title))\n      const repeated=[...new Set(seen.filter((value,i)=>seen.indexOf(value)!==i))]\n      const resetVisible=await button(a,'Muat dari awal').isVisible()\n      const persisted=after.filter(row=>['R0','R50'].includes(row.title))\n      const chronology={first,middle,tail,sql,moved:persisted,priorIds:before.map(r=>r.id),afterIds:after.map(r=>r.id)}\n      Object.assign(proof,{total:sql.length,unique:new Set(seen).size,missed,repeated,informed,resetVisible,chronology,ordinaryEdits:2})\n      if(resetVisible) await button(a,'Muat dari awal').click()\n      await ready(a)\n      const reread=[...await titles(a)]\n      for(let i=25;i<sql.length;i+=25){await next(a);reread.push(...await titles(a))}\n      assert.deepEqual(reread,sql);proof.manualRestartUnique=new Set(reread).size\n      assert.ok(informed||(missed.length===0&&repeated.length===0),'Moving across three pages silently repeated '+repeated+' and missed '+missed)\n    })\n  } finally {await browser.close()}\n}\nrun().catch(error=>{console.error(error);process.exitCode=1})\n"
